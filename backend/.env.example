# Solana RPC Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/solana_alpha
# Or use SQLite for development
# DATABASE_URL=sqlite+aiosqlite:///./solana_alpha.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# API Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# DexScreener API
DEXSCREENER_API_URL=https://api.dexscreener.com/latest

# Jupiter API
JUPITER_API_URL=https://quote-api.jup.ag/v6

# Birdeye API (optional)
BIRDEYE_API_KEY=
BIRDEYE_API_URL=https://public-api.birdeye.so

# Subscription/Monetization
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Smart Money Tracker Settings
SMART_MONEY_UPDATE_INTERVAL=300  # 5 minutes
MIN_WALLET_VOLUME_SOL=100  # Minimum volume to track
LEADERBOARD_SIZE=100

# Token Scanner Settings
RISK_SCORE_CACHE_TTL=3600  # 1 hour
MAX_SCANS_FREE_TIER=100  # per day
